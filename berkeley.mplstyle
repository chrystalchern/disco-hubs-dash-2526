# for reference, see https://github.com/matplotlib/matplotlib/blob/main/lib/matplotlib/mpl-data/stylelib/classic.mplstyle

axes.spines.top : False
axes.spines.bottom : False
axes.spines.left : False
axes.spines.right : False

font.family : sans-serif
font.sans-serif : Arial

xtick.bottom : False
xtick.top : False
ytick.left : False
ytick.right : False
# ytick.labelleft : False

# Custom palette combining primary and secondary preferred palette
# Berkeley Blue
# California Gold
# Green Dark
# Rose Dark
# Blue Dark
# Gold Dark
# Purple Dark
axes.prop_cycle : cycler('color', ['002676', 'FDB515', '00553A', '770747', '010133', 'FC9313', '431170'])

